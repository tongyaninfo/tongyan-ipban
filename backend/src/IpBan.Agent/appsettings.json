{
  "Agent": {
    "DataDirectory": "data",
    "DatabaseFileName": "ipban.sqlite3",
    "StrictEventCompleteness": false
  },
  "IdGeneration": {
    "WorkerId": 1
  },
  "AgentIpc": {
    "SocketPath": "/run/ipban/ipban-agent.sock",
    "PipeName": "ipban-agent"
  },
  "Collectors": {
    "LinuxSsh": {
      "Enabled": true,
      "Unit": "sshd.service",
      "MaxLines": 1000
    },
    "LinuxVnc": {
      "Enabled": true,
      "Source": "Journal",
      "JournalIdentifiers": ["Xvnc", "Xtigervnc"],
      "LogFiles": [],
      "LookbackSeconds": 300,
      "MaxLines": 10000,
      "MaxFileBytesPerPoll": 1048576
    }
  },
  "Logging": {
    "File": {
      "Directory": "logs",
      "RetentionDays": 365,
      "MaxFileSizeBytes": 52428800,
      "CompressRotated": true,
      "MinimumLevel": "Information"
    },
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}
