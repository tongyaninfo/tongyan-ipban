{
  "Management": {
    "ListenAddress": "0.0.0.0",
    "HttpPort": 5180,
    "HttpsEnabled": true,
    "HttpsPort": 8443
  },
  "AgentIpc": {
    "SocketPath": "/run/ipban/ipban-agent.sock",
    "PipeName": "ipban-agent"
  },
  "Logging": {
    "File": {
      "Directory": "logs",
      "RetentionDays": 365,
      "MaxFileSizeBytes": 52428800,
      "CompressRotated": true,
      "MinimumLevel": "Information"
    },
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
